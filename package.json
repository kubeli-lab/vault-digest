{
	"name": "vault-digest",
	"version": "1.2.5",
	"description": "Sync your vault to GitHub with rebase and commit messages that summarise your notes.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "node test/run.cjs"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "8.73.0",
		"@typescript-eslint/parser": "8.73.0",
		"esbuild": "0.28.1",
		"obsidian": "1.14.4",
		"tslib": "2.4.0",
		"typescript": "5.9.3"
	},
	"dependencies": {
		"simple-git": "^4.1.0"
	}
}
